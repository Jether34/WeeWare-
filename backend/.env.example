NODE_ENV=development
PORT=5021
MONGODB_URI=mongodb://127.0.0.1:27017/weeware
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
# Set to 1 only when exactly one trusted reverse proxy sits in front of Express.
TRUST_PROXY=0
ML_SERVICE_URL=http://127.0.0.1:8021
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=1073741824
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=WeeWare
SMTP_FROM_EMAIL=mailer@example.com
FRONTEND_URL=https://pns-sysnnova.cloud

